# ===== Common =====
ENV=production
LOG_LEVEL=INFO
TZ=Europe/Moscow

# ===== Postgres =====
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=vpn_pix
POSTGRES_USER=vpn_pix
POSTGRES_PASSWORD=change_me_strong_password

# ===== Redis =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_strong_redis_password

# ===== Backend =====
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# 64+ random chars: openssl rand -hex 48
BACKEND_SERVICE_TOKEN=change_me_to_long_random_64_chars
JWT_SECRET=change_me_to_long_random_64_chars
JWT_TTL_HOURS=24
# Comma-separated allowed CORS origins for admin SPA
CORS_ORIGINS=https://pix-app.xyz,http://localhost:5173

# ===== Admin =====
# 64+ random chars — initial admin key (will be hashed and stored in DB)
ADMIN_INITIAL_KEY=change_me_to_long_random_64_chars
ADMIN_INITIAL_KEY_LABEL=main
ADMIN_KEY_GRACE_HOURS=3
# Telegram tg_id of the admin who receives [АУД] alerts (critical events,
# reconcile circuit breaker, etc.). Leave empty to disable alerting.
ADMIN_TG_ID=

# ===== Bot =====
BOT_TOKEN=123456789:AA-from-BotFather
BACKEND_API_URL=http://backend:8000
REQUIRED_CHANNEL_ID=-1001234567890
REQUIRED_CHANNEL_URL=https://t.me/yourchannel
SUPPORT_GROUP_ID=-1001234567891
SUPPORT_GROUP_URL=https://t.me/yourgroup
# Ссылка на пост/страницу с инструкцией по подключению клиентов VPN
HOWTO_CONNECT_URL=https://pix-app.xyz/how-to-connect
PUBLIC_BOT_USERNAME=your_bot_username
# База, куда платёжные провайдеры шлют webhook'и: https://api.<domain>
PUBLIC_WEBHOOK_BASE_URL=https://api.example.com

# ===== External: NorthLine reseller API =====
NORTHLINE_API_URL=https://northline-vpn.xyz/api/v1
NORTHLINE_PROVIDER_KEY=nlprov_xxxxxxxxxxxxxxxx
NORTHLINE_BEARER_TOKEN=nlrsk_live_xxxxxxxxxxxxxxxx
# true → create_key уходит c "test": true, провайдер не списывает баланс
# и возвращает фейковый subscription. Для прод-окружения держим false.
NORTHLINE_TEST_MODE=false

# ===== Платёжные провайдеры =====
PLATEGA_API_KEY=
PLATEGA_SHOP_ID=
PLATEGA_SECRET=
CRYPTOBOT_API_TOKEN=

# ===== Admin SPA (slug + build-time) =====
# Слаг секретный, под него отдаётся админка по /<slug>/
ADMIN_PATH_SLUG=change_me_random_slug
VITE_BASE_PATH=/change_me_random_slug/
VITE_API_BASE_URL=/change_me_random_slug/api
