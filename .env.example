# ===== Common =====
ENV=production
LOG_LEVEL=INFO
TZ=Europe/Moscow

# ===== Postgres =====
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=vpn_pix
POSTGRES_USER=vpn_pix
POSTGRES_PASSWORD=change_me_strong_password

# ===== Redis =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_strong_redis_password

# ===== Backend =====
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# 64+ random chars: openssl rand -hex 48
BACKEND_SERVICE_TOKEN=change_me_to_long_random_64_chars
JWT_SECRET=change_me_to_long_random_64_chars
JWT_TTL_HOURS=24
# Comma-separated allowed CORS origins for admin SPA
CORS_ORIGINS=https://admin.pixio.icu,http://localhost:5173

# ===== Admin =====
# 64+ random chars — initial admin key (will be hashed and stored in DB)
ADMIN_INITIAL_KEY=change_me_to_long_random_64_chars
ADMIN_INITIAL_KEY_LABEL=main
ADMIN_KEY_GRACE_HOURS=3

# ===== Bot =====
BOT_TOKEN=123456789:AA-from-BotFather
BACKEND_API_URL=http://backend:8000
REQUIRED_CHANNEL_ID=-1001234567890
REQUIRED_CHANNEL_URL=https://t.me/yourchannel
SUPPORT_GROUP_ID=-1001234567891
SUPPORT_GROUP_URL=https://t.me/yourgroup
# Stage 2+: ссылка на пост канала с инструкцией подключения
HOWTO_CONNECT_URL=https://t.me/yourchannel/123

# ===== External (Stage 1: заглушки, наполняются в Stage 2) =====
NORTHLINE_API_URL=https://api.northline.vpn
NORTHLINE_PROVIDER_KEY=
NORTHLINE_BEARER_TOKEN=

PLATEGA_API_KEY=
PLATEGA_SHOP_ID=
PLATEGA_SECRET=
CRYPTOBOT_API_TOKEN=

# ===== Frontend (admin) build-time =====
VITE_API_BASE_URL=https://admin.pixio.icu/api
